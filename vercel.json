{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/treatment-assessment",
      "destination": "/restoration-map",
      "permanent": false
    },
    {
      "source": "/:path((?!restoration-map|tools/wholesome/|api/wholesome-).+)",
      "has": [
        {
          "type": "host",
          "value": "assessment.wholesomeempireyyc.com"
        }
      ],
      "destination": "/",
      "permanent": false
    }
  ]
}
